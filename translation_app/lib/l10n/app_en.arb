  "pagesHowToUseStep1": "Open Jusoor and pick a source text or image template from the top of the Home screen.",
  "@pagesHowToUseStep1": {
    "description": "Step 1 of the how-to-use instructions."
  },

  "pagesHowToUseStep2": "Choose your target language, then type or paste text (or pick an image) in the input area.",
  "@pagesHowToUseStep2": {
    "description": "Step 2 of the how-to-use instructions."
  },

  "pagesHowToUseStep3": "Tap Translate to see the result below. You can copy, share, or open it in the full output view.",
  "@pagesHowToUseStep3": {
    "description": "Step 3 of the how-to-use instructions."
  },

  "pagesHowToUseStep4": "To translate from another app, use the system Share menu and pick Jusoor — text, links, and images are supported.",
  "@pagesHowToUseStep4": {
    "description": "Step 4 of the how-to-use instructions."
  },

  "pagesHowToUseStep5": "For a floating translator on top of any app, add the Quick Settings 'Translate' tile and tap it to open the overlay.",
  "@pagesHowToUseStep5": {
    "description": "Step 5 of the how-to-use instructions."
  },

  "pagesHowToWritePromptsHeader": "How to write good prompts",
  "@pagesHowToWritePromptsHeader": {
    "description": "Section header for prompt-writing tips."
  },

  "pagesHowToWritePromptsTip1": "State the desired tone and register (formal, casual, technical, marketing, etc.) so the model matches your audience.",
  "@pagesHowToWritePromptsTip1": {
    "description": "Tip 1 for writing good translation prompts."
  },

  "pagesHowToWritePromptsTip2": "Mention the domain (medical, legal, software, gaming) so the model uses the right vocabulary and conventions.",
  "@pagesHowToWritePromptsTip2": {
    "description": "Tip 2 for writing good translation prompts."
  },

  "pagesHowToWritePromptsTip3": "List any terms, brand names, or product names that must be kept untranslated.",
  "@pagesHowToWritePromptsTip3": {
    "description": "Tip 3 for writing good translation prompts."
  },

  "pagesHowToWritePromptsTip4": "Tell the model what to do with ambiguity: prefer literal, prefer natural, ask for clarification, or pick the most common reading.",
  "@pagesHowToWritePromptsTip4": {
    "description": "Tip 4 for writing good translation prompts."
  },

  "pagesHowToWritePromptsTip5": "Specify the output format you want: plain text, markdown, JSON, or line-by-line preserving the source structure.",
  "@pagesHowToWritePromptsTip5": {
    "description": "Tip 5 for writing good translation prompts."
  },

  "pagesHowToWritePromptsTip6": "Include short examples of the style you want — one or two before/after pairs are usually more effective than a long rule list.",
  "@pagesHowToWritePromptsTip6": {
    "description": "Tip 6 for writing good translation prompts."
  },

