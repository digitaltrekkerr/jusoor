  "pagesPermissionScreenCaptureTitle": "Screen capture (screenshot translation)",
  "@pagesPermissionScreenCaptureTitle": {
    "description": "Friendly title for the screen-capture / MediaProjection permission row."
  },

  "pagesPermissionScreenCaptureBody": "When you tap Screenshot in the overlay, Jusoor hides its own window and captures everything currently visible on the screen — including other apps — then sends that image to the translation provider you configured (e.g. OpenRouter/Gemini/OpenAI/custom) to translate the text in it. The image is not saved to your device; only the translated text is kept in History. Android shows a consent dialog before any capture, and capture stops when the overlay closes.",
  "@pagesPermissionScreenCaptureBody": {
    "description": "Explanation of the screen-capture / MediaProjection permission."
  },

  "pagesPermissionScreenCaptureGrant": "Try now",
  "@pagesPermissionScreenCaptureGrant": {
    "description": "Label for the Grant button on the screen-capture permission row."
  },

  "pagesPermissionOverlayTitle": "Overlay (Display over other apps)",
  "@pagesPermissionOverlayTitle": {
    "description": "Friendly title for the SYSTEM_ALERT_WINDOW permission row."
  },

  "pagesPermissionOverlayBody": "Jusoor draws its floating translation window on top of other apps. It opens only when you tap the Quick Settings 'Translate' tile or the overlay button. While it is open, touches inside the shaded top area are handled by the overlay; it never runs invisibly.",
  "@pagesPermissionOverlayBody": {
    "description": "Explanation of the SYSTEM_ALERT_WINDOW permission."
  },

  "pagesPermissionOverlayGrant": "Enable",
  "@pagesPermissionOverlayGrant": {
    "description": "Label for the Grant button on the overlay permission row."
  },

  "pagesPermissionNotificationsTitle": "Notifications",
  "@pagesPermissionNotificationsTitle": {
    "description": "Friendly title for the POST_NOTIFICATIONS permission row."
  },

  "pagesPermissionNotificationsBody": "Android requires a visible notification while the translation overlay service is running. This notification shows 'Translator Overlay is active' and disappears when the overlay closes. It is only used to keep the overlay alive.",
  "@pagesPermissionNotificationsBody": {
    "description": "Explanation of the POST_NOTIFICATIONS permission."
  },

  "pagesPermissionNotificationsGrant": "Enable",
  "@pagesPermissionNotificationsGrant": {
    "description": "Label for the Grant button on the notifications permission row."
  },

  "pagesPermissionFgsTitle": "Background service (overlay engine)",
  "@pagesPermissionFgsTitle": {
    "description": "Friendly title for the FOREGROUND_SERVICE permission row."
  },

  "pagesPermissionFgsBody": "A small background service keeps the overlay working while you use other apps. Android always shows it in the active-apps list with a notification. It starts when the overlay is opened and stops when the overlay is closed.",
  "@pagesPermissionFgsBody": {
    "description": "Explanation of the FOREGROUND_SERVICE permission."
  },

  "pagesPermissionInternetTitle": "Internet access",
  "@pagesPermissionInternetTitle": {
    "description": "Friendly title for the INTERNET permission row."
  },

  "pagesPermissionInternetBody": "Jusoor sends the content you translate (text you type, files you share, or screenshots) over an encrypted connection to the translation provider you chose in Settings. Anyone with your API key can read what is sent to that provider — keep your keys private and be mindful of what you translate.",
  "@pagesPermissionInternetBody": {
    "description": "Explanation of the INTERNET permission."
  },

  "pagesPermissionClipboardTitle": "Clipboard (Paste in the overlay)",
  "@pagesPermissionClipboardTitle": {
    "description": "Friendly title for the clipboard access description row."
  },

  "pagesPermissionClipboardBody": "The Paste button in the overlay reads your device clipboard so you can translate text copied from other apps. On modern Android this may briefly open a transparent window once, and Jusoor keeps the text in memory for up to a minute as a fallback. Cached content auto-clears after a minute. Nothing is stored permanently.",
  "@pagesPermissionClipboardBody": {
    "description": "Explanation of how the overlay accesses the clipboard."
  },

  "pagesPermissionShareTitle": "Share from other apps",
  "@pagesPermissionShareTitle": {
    "description": "Friendly title for the share-from-other-apps description row."
  },

  "pagesPermissionShareBody": "Any app can open Jusoor through the system Share menu to translate text, links or files. Shared content is uploaded to the translation provider for processing. This is how quick-translate works and cannot be disabled without losing the feature.",
  "@pagesPermissionShareBody": {
    "description": "Explanation of the share intent entry point."
  },

  "pagesPermissionQuickSettingsTitle": "Quick Settings 'Translate' tile",
  "@pagesPermissionQuickSettingsTitle": {
    "description": "Friendly title for the Quick Settings Tile description row."
  },

  "pagesPermissionQuickSettingsBody": "Jusoor adds a tile to your Quick Settings (Android 7+) that opens the overlay directly. Requires the overlay permission to be enabled.",
  "@pagesPermissionQuickSettingsBody": {
    "description": "Explanation of the Quick Settings Tile feature."
  },

  "pagesPermissionFilesTitle": "Importing files",
  "@pagesPermissionFilesTitle": {
    "description": "Friendly title for the file-import description row."
  },

  "pagesPermissionFilesBody": "Files are imported through the system file picker — you choose each file, and Jusoor never scans your storage. The chosen file's text is uploaded to the translation provider for translation.",
  "@pagesPermissionFilesBody": {
    "description": "Explanation of how file import works and its privacy implications."
  },

