<?xml version="1.0" encoding="utf-8"?><!--
  Cloud backup (Android 12+, Auto Backup) rules.

  Excluded because they contain sensitive user content:
  - translation_history.db*: full input/output text of every translation.
  - FlutterSharedPreferences.xml: provider profiles, prompt templates.
  - FlutterSecureStorage.xml: encrypted API-key material (ciphertext is
    useless without the device Keystore key, but never leave the app anyway).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
