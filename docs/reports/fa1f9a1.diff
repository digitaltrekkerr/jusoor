+      final dio = createMockStreamingDio();
+      final provider = OpenRouterProvider(apiKey: 'k', dio: dio);
+
+      await provider
+          .translate(
+            TranslationRequest(
+              inputText: 'Hello',
+              targetLanguage: 'Arabic',
+              systemPrompt: 'Translate to {{target_language}}.',
+            ),
+          )
+          .toList();
+
+      final body = capturedRequest!.data as Map<String, dynamic>;
+      expect(body.containsKey('reasoning'), isFalse,
+          reason: 'enableThinking defaults to false');
+      // `request.stream` is false by default and the provider-level
+      // `stream` default is true, so the wire value is `true` until the
+      // caller explicitly disables streaming.
+      expect(body['stream'], isTrue,
+          reason: 'provider default stream=true, request default stream=false');
+      expect(body['max_tokens'], 20000,
+          reason: 'maxOutputWords=10000 → max_tokens=20000');
+    });
+
+    test('enableThinking=true attaches reasoning.effort=low', () async {
