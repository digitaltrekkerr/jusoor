+                    Uint8List.fromList(utf8.encode(sse)),
+                  ]),
+                  200,
+                ),
+                statusCode: 200,
+              ),
+            );
+          },
+        ),
+      );
+      return dio;
+    }
+
+    setUp(() {
+      capturedRequest = null;
+    });
+
+    test('default request — reasoning absent, stream false, max_tokens set',
