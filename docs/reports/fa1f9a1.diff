diff --git a/packages/translation_core/lib/src/providers/openrouter_capabilities.dart b/packages/translation_core/lib/src/providers/openrouter_capabilities.dart
new file mode 100644
index 0000000..dd29f0d
--- /dev/null
+++ b/packages/translation_core/lib/src/providers/openrouter_capabilities.dart
@@ -0,0 +1,161 @@
+import 'package:dio/dio.dart';
+
+/// One model's reasoning capability block from OpenRouter's `/api/v1/models`.
+///
+/// Source: https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
+/// Sample payload:
+/// ```
+/// {
+///   "id": "google/gemini-3.5-flash",
+///   "reasoning": {
+///     "supported_efforts": ["high", "medium", "low", "minimal"],
+///     "default_effort": "medium",
+///     "default_enabled": true,
+///     "mandatory": true
+///   }
+/// }
+/// ```
+class OpenRouterReasoningCapability {
+  const OpenRouterReasoningCapability({
+    required this.supportedEfforts,
+    required this.defaultEnabled,
+    required this.mandatory,
+  });
+
+  /// Efforts the model accepts for `reasoning.effort`, e.g.
+  /// `['xhigh', 'high', 'medium', 'low', 'minimal', 'none']`.
+  final List<String> supportedEfforts;
+
+  /// Whether the model is reasoning by default.
+  final bool defaultEnabled;
+
+  /// Whether reasoning cannot be turned off for this model.
+  final bool mandatory;
+
+  /// True when the model exposes a controllable `reasoning` block and
+  /// reasoning can actually be turned off.
+  bool get supportsReasoning => supportedEfforts.isNotEmpty && !mandatory;
+
+  /// Recommended `reasoning.effort` to send when thinking is enabled.
+  ///
+  /// Falls back to the first supported effort (e.g. `low`) if OpenRouter
+  /// has not provided a `default_effort`. The caller should treat this as
+  /// a hint, not a guarantee.
+  String get recommendedEffort {
+    if (supportedEfforts.isEmpty) return 'low';
+    if (supportedEfforts.contains('low')) return 'low';
+    return supportedEfforts.first;
+  }
+
+  Map<String, dynamic> toJson() => <String, dynamic>{
+        'supported_efforts': supportedEfforts,
+        'default_enabled': defaultEnabled,
+        'mandatory': mandatory,
+      };
+
+  factory OpenRouterReasoningCapability.fromJson(Map<String, dynamic> json) {
+    final rawList = json['supported_efforts'];
+    final list = rawList is List
+        ? rawList.map((e) => e.toString()).toList()
+        : const <String>[];
+    return OpenRouterReasoningCapability(
+      supportedEfforts: list,
+      defaultEnabled: json['default_enabled'] as bool? ?? false,
+      mandatory: json['mandatory'] as bool? ?? false,
+    );
+  }
+}
+
+/// In-memory snapshot of OpenRouter model capabilities.
+///
+/// Produced by [OpenRouterCapabilities.refresh] and passed straight to
+/// [OpenRouterCapabilities.get] lookups. Snapshots are immutable.
+class OpenRouterCapabilitiesSnapshot {
+  const OpenRouterCapabilitiesSnapshot(this.byModelId);
+
+  /// Capability indexed by model id (e.g. `google/gemini-3.5-flash`).
+  final Map<String, OpenRouterReasoningCapability> byModelId;
+
+  /// Returns the capability for [modelId], or `null` if the model is unknown.
+  OpenRouterReasoningCapability? operator [](String modelId) =>
+      byModelId[modelId];
+
+  /// True if [modelId] is known to support a controllable reasoning block.
+  bool supportsReasoning(String modelId) =>
+      byModelId[modelId]?.supportsReasoning ?? false;
+
+  /// True if [modelId] is known to have mandatory reasoning (cannot be
+  /// disabled, e.g. certain Gemini 2.5 / 3.x models).
+  bool isMandatory(String modelId) =>
+      byModelId[modelId]?.mandatory ?? false;
+}
+
+/// Fetches OpenRouter model capabilities (specifically the `reasoning`
+/// block) so callers can decide whether to attach `reasoning.effort` to a
+/// translation request.
+///
+/// The snapshot is held in memory only — caching across process restarts
+/// is intentionally left to the caller (e.g. via `SharedPreferences` in
+/// the application layer) to avoid pulling platform dependencies into
+/// `translation_core`.
+class OpenRouterCapabilities {
+  OpenRouterCapabilities({Dio? dio}) : _dio = dio ?? Dio();
+
+  final Dio _dio;
+
+  OpenRouterCapabilitiesSnapshot? _snapshot;
+
+  /// Returns the reasoning capability for [modelId], or `null` when the
+  /// model is unknown or capabilities have not been loaded yet.
+  ///
+  /// Tries the in-memory snapshot first, then falls back to a fresh API
+  /// fetch. Callers wanting to surface a manual "Refresh" action can use
+  /// [refresh] instead.
+  Future<OpenRouterReasoningCapability?> get(String modelId) async {
+    final snapshot = _snapshot ??= await _fetch();
+    return snapshot?[modelId];
+  }
+
+  /// Forces a refresh from the OpenRouter API. Safe to call repeatedly.
+  Future<OpenRouterCapabilitiesSnapshot?> refresh() async {
+    _snapshot = await _fetch();
+    return _snapshot;
+  }
+
+  Future<OpenRouterCapabilitiesSnapshot?> _fetch() async {
+    try {
+      final res = await _dio.get<Map<String, dynamic>>(
+        'https://openrouter.ai/api/v1/models',
+        options: Options(
+          headers: <String, String>{'Content-Type': 'application/json'},
+          responseType: ResponseType.json,
+        ),
+      );
+      final data = res.data;
+      if (data == null) return null;
+      final list = data['data'];
+      if (list is! List) return null;
+      final out = <String, OpenRouterReasoningCapability>{};
+      for (final raw in list) {
+        if (raw is! Map) continue;
+        final id = raw['id'];
+        final reasoning = raw['reasoning'];
+        if (id is String && reasoning is Map) {
+          out[id] = OpenRouterReasoningCapability.fromJson(
+            Map<String, dynamic>.from(reasoning),
+          );
+        }
+      }
+      return OpenRouterCapabilitiesSnapshot(Map.unmodifiable(out));
+    } on DioException {
+      return null;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// Releases the underlying [Dio] instance.
+  void dispose() {
+    _dio.close(force: true);
+  }
+}
