+        /**
+         * Removes a best-effort subset of Markdown formatting so the
+         * clipboard receives a plain-text rendering. Mirrors the Dart
+         * `toPlainText` helper in
+         * `packages/markdown_renderer/lib/src/utils/markdown_stripper.dart`
+         * — keep them in sync if you extend either side.
+         *
+         * Order matters: fenced code blocks (``` … ```) must be stripped
+         * before inline `code` so the inner content is not over-processed.
+         */
+        internal fun stripMarkdownForClipboard(input: String): String {
+            if (input.isEmpty()) return input
+            var s = input
+            // Fenced code blocks: ```lang\n…\n```
+            s = s.replace(Regex("```[\\s\\S]*?```"), " ")
+            // Inline code: `foo` (avoid eating emphasis backticks)
+            s = s.replace(Regex("`([^`]+)`"), "$1")
+            // Markdown links/images: ![alt](url) and [text](url) → text/alt
+            s = s.replace(Regex("!\\[[^\\]]*]\\([^)]*\\)"), "")
+            s = s.replace(Regex("\\[([^\\]]+)]\\([^)]*\\)"), "$1")
+            // Headings (#, ##, ###) and blockquotes at line start
+            s = s.replace(Regex("(?m)^#{1,6}\\s+"), "")
+            s = s.replace(Regex("(?m)^>\\s?"), "")
+            // Unordered list bullets (-, *, +) at line start
+            s = s.replace(Regex("(?m)^[ \\t]*[-*+]\\s+"), "")
+            // Ordered list markers (1. , 2) ) at line start
+            s = s.replace(Regex("(?m)^[ \\t]*\\d+[.)]\\s+"), "")
+            // Horizontal rules
+            s = s.replace(Regex("(?m)^[ \\t]*([-*_])\\1{2,}[ \\t]*$"), " ")
+            // Bold/italic: **bold**, __bold__, *italic*, _italic_
+            s = s.replace(Regex("\\*\\*([^*]+)\\*\\*"), "$1")
+            s = s.replace(Regex("__([^_]+)__"), "$1")
+            s = s.replace(Regex("(?<!\\w)\\*([^*]+)\\*(?!\\w)"), "$1")
+            s = s.replace(Regex("(?<!\\w)_([^_]+)_(?!\\w)"), "$1")
+            // Collapse repeated whitespace to a single space and trim.
+            return s.replace(Regex("[\\s\\u00A0]+"), " ").trim()
+        }
