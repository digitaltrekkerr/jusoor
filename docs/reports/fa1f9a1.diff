@@ -0,0 +1,82 @@
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:translation_app/services/articles_service.dart';
+
+/// Articles are intentionally Arabic-only regardless of the app locale
+/// (see invariant comment in `screens/article_screen.dart`). These tests
+/// guard that invariant so a future i18n pass does not silently start
+/// surfacing English copies of the bundled Markdown.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  group('kAppArticles — Arabic content invariant', () {
+    test('contains the expected number of bundled articles', () {
+      expect(kAppArticles, hasLength(greaterThanOrEqualTo(3)));
+    });
+
+    test('every article id is a 2-digit numeric prefix', () {
+      final idPattern = RegExp(r'^\d{2}$');
+      for (final article in kAppArticles) {
+        expect(
+          idPattern.hasMatch(article.id),
+          isTrue,
+          reason: 'Article id "${article.id}" should be a 2-digit prefix',
+        );
+      }
+    });
+
+    test('every article title contains Arabic characters', () {
+      final arabicRange = RegExp(r'[\u0600-\u06FF]');
+      for (final article in kAppArticles) {
+        expect(
+          arabicRange.hasMatch(article.title),
+          isTrue,
+          reason:
+              'Article title "${article.title}" should contain Arabic '
+              'characters (articles are Arabic-only by design)',
+        );
+      }
+    });
+
+    test('every article excerpt contains Arabic characters', () {
+      final arabicRange = RegExp(r'[\u0600-\u06FF]');
+      for (final article in kAppArticles) {
+        expect(
+          arabicRange.hasMatch(article.excerpt),
+          isTrue,
+          reason:
+              'Article excerpt for "${article.id}" should contain Arabic '
+              'characters (articles are Arabic-only by design)',
+        );
+      }
+    });
+
+    test('every article asset path points under assets/articles/', () {
+      for (final article in kAppArticles) {
+        expect(
+          article.asset,
+          startsWith('assets/articles/'),
+          reason: 'Article asset "${article.asset}" should live under '
+              'assets/articles/',
+        );
+        expect(
+          article.asset,
+          endsWith('.md'),
+          reason: 'Article asset "${article.asset}" should be a .md file',
+        );
+      }
+    });
+
+    test('article assets correspond to actual bundled Markdown files', () async {
+      // Sanity check: loadArticleBody should succeed for every article.
+      // If an asset path drifts from the bundle, this test fails fast.
+      for (final article in kAppArticles) {
+        final body = await loadArticleBody(article);
+        expect(
+          body,
+          isNotEmpty,
+          reason: 'Body of article "${article.id}" should be non-empty',
+        );
+      }
+    });
+  });
+}
